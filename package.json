{
  "name": "request-helper",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "prepare": "wxt prepare",
    "package:local": "wxt build --mode development && node scripts/package-local.mjs",
    "build": "wxt build",
    "zip": "wxt zip",
