    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "tsx": "^4.20.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
